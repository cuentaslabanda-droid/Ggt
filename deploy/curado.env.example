# /etc/curado.env  (chmod 600)
CURADO_TOKEN=cambia-este-token
CURADO_DATA=/var/lib/curado
# Avisos al móvil con la app ntfy (elige un tema difícil de adivinar):
# CURADO_ALERT_URL=https://ntfy.sh/mi-camara-curado-x7k2
CURADO_OFFLINE_MIN=10
# Borrar telemetría más antigua que N días (0 = nunca):
CURADO_RETENTION_DAYS=0
