# /etc/curado.env  (chmod 600: contiene contraseñas)
# Cada canal de aviso se activa sólo con rellenar sus credenciales.
# Tras cambiar algo:  sudo systemctl restart curado
# y prueba con el botón "Enviar mensaje de prueba" del panel.

CURADO_TOKEN=cambia-este-token
CURADO_DATA=/var/lib/curado
CURADO_OFFLINE_MIN=10
# Borrar telemetría más antigua que N días (0 = nunca):
CURADO_RETENTION_DAYS=0

# --- ntfy (notificación push al móvil, gratis; app "ntfy") -----------------------
#CURADO_NTFY_URL=https://ntfy.sh/mi-camara-curado-x7k2

# --- Correo (Gmail: activa la verificación en 2 pasos y crea una
#     "contraseña de aplicación" en https://myaccount.google.com/apppasswords) -----
#CURADO_SMTP_HOST=smtp.gmail.com
#CURADO_SMTP_PORT=587
#CURADO_SMTP_USER=tucorreo@gmail.com
#CURADO_SMTP_PASSWORD=abcd efgh ijkl mnop
#CURADO_SMTP_FROM=tucorreo@gmail.com
#CURADO_EMAIL_TO=tucorreo@gmail.com,otra@persona.com

# --- Telegram (habla con @BotFather -> /newbot para el token; manda un mensaje
#     a tu bot y mira tu chat_id en https://api.telegram.org/bot<TOKEN>/getUpdates) -
#CURADO_TELEGRAM_TOKEN=123456789:AA...
#CURADO_TELEGRAM_CHAT_IDS=111111111,222222222

# --- WhatsApp gratis con CallMeBot (https://www.callmebot.com/blog/free-api-whatsapp-messages/)
#     telefono:apikey separados por comas -----------------------------------------------
#CURADO_CALLMEBOT=+5215512345678:123456

# --- Slack / Discord / Home Assistant / cualquier webhook que acepte JSON -----------------
#CURADO_WEBHOOK_URLS=https://hooks.slack.com/services/...,https://discord.com/api/webhooks/...

# --- Twilio: SMS y llamadas por internet, sin línea analógica (de pago) -------------
#CURADO_TWILIO_SID=ACxxxxxxxx
#CURADO_TWILIO_TOKEN=xxxxxxxx
#CURADO_TWILIO_FROM=+15551234567
#CURADO_TWILIO_SMS_TO=+5215512345678
#CURADO_TWILIO_CALL_TO=+5215512345678,+5215587654321

# --- Llamadas por la línea analógica (Asterisk + Grandstream HT813) ----------------
#     Ver docs/alarmas.md y deploy/install-asterisk.sh. Números como los
#     marcarías desde el teléfono de casa; se llaman uno tras otro (2 min).
#CURADO_ASTERISK_NUMBERS=5512345678,5587654321
#CURADO_ASTERISK_CHANNEL=PJSIP/{number}@fxo

# --- Vigilancia externa: si la Pi se apaga o pierde internet, este servicio
#     te avisa (https://healthchecks.io, gratis). Pega aquí la URL de "ping". ----
#CURADO_HEARTBEAT_URL=https://hc-ping.com/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
